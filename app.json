{
  "expo": {
    "name": "Toolers: All In One Toolkit",
    "slug": "toolers",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toolers",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.toolers"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2f8f9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.toolers"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f2f8f9",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#242525"
          }
        }
      ],
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5112178843530951~7675646040",
          "iosAppId": "ca-app-pub-5112178843530951~7675646040"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8c791f1-b04c-4eff-92c7-b1f0ffe698e4"
      }
    }
  }
}
